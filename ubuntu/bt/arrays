→ imprimindo a saída com 'cat' -- caminho...
-- ~/.config/nvim/luasnip/c_snippets.lua
local ls = require("luasnip")
local s = ls.snippet
local i = ls.insert_node
local t = ls.text_node

-- Estrutura Main
ls.add("c", s({ trig = "main", name = "Função Main" }, {
  t("int main(int argc, char *argv[]) {"),
  t("  "), i(0),
  t("  return 0;"),
  t("}"),
}))

-- Include padrão
ls.add("c", s({ trig = "inc", name = "Includes Comuns" }, {
  t("#include <stdio.h>"),
  t("#include <stdlib.h>"),
  t("#include <string.h>"),
}))

-- Printf com placeholder
ls.add("c", s({ trig = "pri", name = "Print Formatado" }, {
  t("printf(\""), i(1, "%d"), t("\", "), i(2, "variavel"), t(");"),
}))

